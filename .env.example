# Supabase Configuration (Required for Phase 1+)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional / Server-only configuration (Deferred to later phases)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key # Not needed for standard app operations
# GEMINI_API_KEY=your-gemini-api-key # Phase 4 only
# GEMINI_MODEL=gemini-2.5-flash # Phase 4 only
