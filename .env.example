# Supabase Configuration (Required for Phase 1+)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional / Server-only configuration
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key # Not needed for standard app operations

# Google Gemini AI Configuration (Phase 4)
# Obtain from Google AI Studio: https://aistudio.google.com/
# NEVER prefix with NEXT_PUBLIC_ and NEVER commit real keys.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

